<Window x:Class="CryoChaos.Views.ScreenFilterLabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Filter Lab"
        Width="760"
        Height="820"
        MinWidth="650"
        MinHeight="620"
        Topmost="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Screen Filter Lab"
                       FontSize="26"
                       FontWeight="Bold" />
            <TextBlock Text="A persistent, click-through DX11 filter over Destiny. Changes update live."
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,16,0,14">
            <StackPanel>
                <TextBlock Text="SHADER STACK"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />
                <TextBlock Text="Select any number. Ctrl+click toggles effects; Shift+click selects a range."
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,8" />
                <ListBox x:Name="EffectStackListBox"
                         Height="145"
                         SelectionMode="Extended"
                         SelectionChanged="LiveSetting_Changed" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Color grading"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="65" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Exposure" VerticalAlignment="Center" />
                        <Slider x:Name="ExposureSlider" Grid.Row="0" Grid.Column="1" Minimum="-2" Maximum="2" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=ExposureSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="1" Text="Contrast" VerticalAlignment="Center" />
                        <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="0.25" Maximum="2.5" Value="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=ContrastSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="2" Text="Saturation" VerticalAlignment="Center" />
                        <Slider x:Name="SaturationSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3" Value="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=SaturationSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="3" Text="Hue" VerticalAlignment="Center" />
                        <Slider x:Name="HueSlider" Grid.Row="3" Grid.Column="1" Minimum="-180" Maximum="180" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=HueSlider, StringFormat={}{0:F0}°}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="4" Text="Temperature" VerticalAlignment="Center" />
                        <Slider x:Name="TemperatureSlider" Grid.Row="4" Grid.Column="1" Minimum="-1" Maximum="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Value, ElementName=TemperatureSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="5" Text="Tint" VerticalAlignment="Center" />
                        <Slider x:Name="TintSlider" Grid.Row="5" Grid.Column="1" Minimum="-1" Maximum="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Value, ElementName=TintSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="6" Text="Gamma" VerticalAlignment="Center" />
                        <Slider x:Name="GammaSlider" Grid.Row="6" Grid.Column="1" Minimum="0.4" Maximum="2.5" Value="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Value, ElementName=GammaSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="7" Text="Red channel" VerticalAlignment="Center" />
                        <Slider x:Name="RedSlider" Grid.Row="7" Grid.Column="1" Minimum="0" Maximum="2" Value="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding Value, ElementName=RedSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="8" Text="Green channel" VerticalAlignment="Center" />
                        <Slider x:Name="GreenSlider" Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="2" Value="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="9" Text="Blue channel" VerticalAlignment="Center" />
                        <Slider x:Name="BlueSlider" Grid.Row="9" Grid.Column="1" Minimum="0" Maximum="2" Value="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="9" Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="10" Text="Vignette" VerticalAlignment="Center" />
                        <Slider x:Name="VignetteSlider" Grid.Row="10" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="LiveSetting_Changed" />
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="{Binding Value, ElementName=VignetteSlider, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="Presets" FontWeight="Bold" Margin="0,14,0,8" />
                    <WrapPanel>
                        <Button Content="Neutral" Tag="Neutral" Click="PresetButton_Click" />
                        <Button Content="Vibrant" Tag="Vibrant" Click="PresetButton_Click" />
                        <Button Content="Cinematic" Tag="Cinematic" Click="PresetButton_Click" />
                        <Button Content="Cold" Tag="Cold" Click="PresetButton_Click" />
                        <Button Content="Warm" Tag="Warm" Click="PresetButton_Click" />
                        <Button Content="Noir" Tag="Noir" Click="PresetButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock"
                       Text="Stopped"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
            <WrapPanel Grid.Column="1">
                <CheckBox x:Name="EditOverGameCheckBox"
                          Content="Edit over game"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Click="EditOverGameCheckBox_Changed" />
                <Button Content="Play Destiny"
                        Click="PlayDestinyButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Start persistent overlay" Click="StartButton_Click" />
                <Button Content="Stop" Click="StopButton_Click" Style="{StaticResource DangerButtonStyle}" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
